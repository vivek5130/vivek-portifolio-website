# Enables free-form answers in the chat widget (quick replies work without it).
# Get a key at https://aistudio.google.com/apikey — copy this file to .env.local and fill it in.
GEMINI_API_KEY=

# Optional: override the chat model (default: gemini-2.0-flash).
# GEMINI_MODEL=

# Your deployed URL, used for social-preview images.
# NEXT_PUBLIC_SITE_URL=https://your-domain.com
